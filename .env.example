# ---------- Server ----------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Infra (matches docker-compose.yml) ----------
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ---------- Google OAuth (login) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an authorised redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---------- Slack OAuth (rate-limit alerts) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ---------- Scheduler tuning (nothing is hardcoded) ----------
# How many jobs one worker processes in parallel
WORKER_CONCURRENCY=5
# Minimum gap between two sends (BullMQ limiter: max 1 job per this many ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard ceiling / default of emails per hour PER SENDER
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Number of Ethereal sender accounts auto-created on first boot
SENDER_COUNT=3
MAX_RECIPIENTS_PER_REQUEST=10000
# Run the worker inside the API process (set false and run `npm run dev:worker` to scale out)
RUN_WORKER_IN_API=true

# ---------- Bull Board (/admin/queues) ----------
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin123
